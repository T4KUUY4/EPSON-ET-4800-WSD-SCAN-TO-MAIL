# Copy to .env. Everything here is optional: the printer and the mail
# server can also be set up in the web UI.

# Port of the web UI
WEB_PORT=8098

# Printer to start with (can be changed in the web UI)
#PRINTER_IP=192.168.0.50

# Only needed if the detected callback address is wrong
# (the IP of the Docker host that the printer sends button events to)
#ADVERTISE_IP=192.168.0.20

# Initial mail server settings; used on the first start only,
# afterwards they are edited in the web UI.
#SMTP_HOST=smtp.example.com
#SMTP_PORT=587
# starttls (port 587), ssl (port 465) or none
#SMTP_SECURITY=starttls
#SMTP_USER=scanner@example.com
#SMTP_PASS=change-me
#MAIL_FROM=scanner@example.com
#MAIL_SUBJECT=Scan
# Recipient of the first destination
#MAIL_TO=you@example.com
